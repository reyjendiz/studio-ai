# ==============================================================================
# Git Ignore for Studio AI / ComfyUI Project
# ==============================================================================

# --- AI Model weights (downloaded via Setup.exe / install.ps1) ---
*.safetensors
*.pth
*.pt
*.bin
*.ckpt
*.onnx
*.part

# Model directories (keep folders via placeholder files, ignore weights)
ComfyUI/models/diffusion_models/*.safetensors
ComfyUI/models/diffusion_models/*.ckpt
ComfyUI/models/text_encoders/*.safetensors
ComfyUI/models/vae/*.safetensors
ComfyUI/models/upscale_models/*.safetensors
ComfyUI/models/upscale_models/*.pth
ComfyUI/models/checkpoints/*.safetensors
ComfyUI/models/checkpoints/*.ckpt
ComfyUI/models/loras/*.safetensors

# Translation model weights and cache
translate/opus-mt-ru-en/*.bin
translate/opus-mt-ru-en/*.safetensors
translate/opus-mt-ru-en/*.spm
translate/opus-mt-ru-en/*.json

# --- Generated user data, images and inputs ---
ComfyUI/output/*
!ComfyUI/output/.gitkeep
ComfyUI/temp/*
!ComfyUI/temp/.gitkeep
ComfyUI/input/*
!ComfyUI/input/.gitkeep

# --- Runtime environments & embedded dependencies ---
python_embeded/
advanced/
update/

# --- Logs & Process dumps ---
logs/
*.log

# --- Browser & WebView2 user profiles and caches ---
ui/profile/
ui/wv2profile/
ui/__pycache__/
__pycache__/
*.py[cod]
*$py.class

# --- OS and editor files ---
.DS_Store
Thumbs.db
desktop.ini
*.tmp
.vscode/
.idea/
*.suo
*.user

# --- Upstream ComfyUI clone (own git repo; installed separately) and local backups ---
ComfyUI/
*.old.*
ui/index.backup-*.html
