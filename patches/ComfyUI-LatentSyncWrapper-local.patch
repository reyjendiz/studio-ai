+# local patch: torchvision >= 0.2x dropped io.write_video/read_video, so use PyAV directly
+def _write_video(path, frames, fps):
+    import av
+    c = av.open(path, mode="w")
+    st = c.add_stream("libx264", rate=int(fps))
+    st.width, st.height, st.pix_fmt = int(frames.shape[2]) // 2 * 2, int(frames.shape[1]) // 2 * 2, "yuv420p"
+    for f in frames.numpy():
+        c.mux(st.encode(av.VideoFrame.from_ndarray(f[:st.height, :st.width], format="rgb24")))
+    c.mux(st.encode(None))
+    c.close()
+
+
+def _read_video(path):
+    import av, numpy as np
+    with av.open(path) as c:
+        return torch.from_numpy(np.stack([f.to_ndarray(format="rgb24") for f in c.decode(video=0)]))
